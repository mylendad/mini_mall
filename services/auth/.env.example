# Пример конфигурации auth-сервиса.
# Скопируйте в .env и подставьте свои значения (для разработки можно ничего не менять).

# URL асинхронного подключения к PostgreSQL (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mini_mall_auth

# Секрет для подписи JWT (HS256). В production — минимум 32 байта, уникальный.
JWT_SECRET=super-secret-jwt-key-change-in-production-1234567890

# Время жизни токенов.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Общие параметры (из common.config.BaseAppSettings).
APP_NAME=auth-service
ENVIRONMENT=development
LOG_LEVEL=INFO