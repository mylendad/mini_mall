# Пример конфигурации cart-сервиса.
# Скопируйте в .env и подставьте свои значения (для разработки можно ничего не менять).

# URL Redis — единственное хранилище состояния корзин.
REDIS_URL=redis://localhost:6379/0

# Базовый URL Catalog-сервиса (валидация продукта при добавлении в корзину).
CATALOG_BASE_URL=http://localhost:8000

# Таймаут HTTP-вызова Catalog, секунды.
CATALOG_HTTP_TIMEOUT=3.0

# Параметры circuit breaker для вызовов Catalog.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=30.0

# TTL корзины (обновляется при каждой записи), секунды.
CART_TTL_SECONDS=604800

# Максимум различных товаров в корзине.
MAX_DISTINCT_ITEMS=50

# Максимум количества одного товара.
MAX_QUANTITY=100

# Endpoint OTLP для трейсов (Jaeger). Пусто — OpenTelemetry выключен.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Общие параметры (из common.config.BaseAppSettings).
APP_NAME=cart-service
ENVIRONMENT=development
LOG_LEVEL=INFO
