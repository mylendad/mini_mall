# Пример конфигурации catalog-сервиса.
# Скопируйте в .env и подставьте свои значения (для разработки можно ничего не менять).

# URL асинхронного подключения к PostgreSQL (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mini_mall_catalog

# URL Elasticsearch (search-проекция, не источник истины).
ELASTICSEARCH_URL=http://localhost:9200

# Таймауты Elasticsearch-клиента (секунды).
ES_REQUEST_TIMEOUT=5.0
ES_CONNECT_TIMEOUT=5.0

# URL Redis (read-through кэш точечных чтений продукта).
REDIS_URL=redis://localhost:6379/0

# TTL кэш-ключа продукта, секунды.
CACHE_TTL_SECONDS=300

# Параметры фонового релея outbox (PG -> ES).
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL=1.0
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_BACKOFF_BASE=1.0

# Срок жизни обработанных строк outbox, секунды. 0 — без чистки.
OUTBOX_RETENTION_SECONDS=86400

# Endpoint OTLP для трейсов (Jaeger). Пусто — OpenTelemetry выключен.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Общие параметры (из common.config.BaseAppSettings).
APP_NAME=catalog-service
ENVIRONMENT=development
LOG_LEVEL=INFO