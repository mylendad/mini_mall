# Пример конфигурации inventory-сервиса.
# Скопируйте в .env и подставьте свои значения (для разработки можно ничего не менять).

# URL асинхронного подключения к PostgreSQL (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mini_mall_inventory

# Адреса брокеров Kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Командный топик саги (reserve/confirm/release от будущего Order Service).
COMMANDS_TOPIC=inventory.commands

# Событийный топик исходов команд и событий склада (inventory.*).
EVENTS_TOPIC=inventory.events

# Consumer group потребителя команд.
CONSUMER_GROUP=inventory-service

# TTL резерва по умолчанию, секунды.
RESERVATION_DEFAULT_TTL_SECONDS=900

# Задание истечения резервов.
# EXPIRATION_BATCH_SIZE=100
# EXPIRATION_INTERVAL=30.0

# Максимум SKU в пакетной проверке доступности (сверх — 422).
AVAILABILITY_BATCH_MAX_SKUS=100

# Параметры фонового релея outbox (PG -> Kafka).
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL=1.0
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_BACKOFF_BASE=1.0

# Срок жизни обработанных строк outbox, секунды. 0 — без чистки.
OUTBOX_RETENTION_SECONDS=86400

# Circuit breaker вокруг Kafka-продюсера релея.
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_OPEN_SECONDS=30.0

# Таймаут публикации сообщения в Kafka, секунды.
# KAFKA_PUBLISH_TIMEOUT=5.0

# Endpoint OTLP для трейсов (Jaeger). Пусто — OpenTelemetry выключен.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Общие параметры (из common.config.BaseAppSettings).
APP_NAME=inventory-service
ENVIRONMENT=development
LOG_LEVEL=INFO
